node_modules/
/target/
/artifacts-*.log
.cache/
.npm-cache/
build/
release/
artifacts/
__pycache__/
*.pyc
.pip-cache/
.desktop-data/
*.log
*.obj
.env
.env.*
!.env.example
!.env.sample

# Generated per-package source identity (contains no user information).
desktop/telemetry-build.json

# Local scratch output, Cloudflare dry-run builds, and sample projects.
tmp/
.wrangler/
samples/

# Native libraries built on Linux/macOS. Windows keeps native/bin/<arch>, which is tracked.
native/bin/linux-*/
native/bin/darwin-*/

# Local Python environments.
.venv/

# Not part of the app: kept outside the public repository.
/AssetReleases/
/labs/
/videos/
/website/
/cloud/
/design/
/artifacts/

# MSVC linker byproducts; only the DLL is used.
native/bin/**/*.exp
native/bin/**/*.lib

# Generated by the Apple preview build.
platforms/apple/*.xcodeproj/
platforms/apple/Generated-Info.plist

# Private outputs and retained upstream release automation.
/productions/
/artifacts-*
/native/bin/
/.github/workflows/ci.yml
/.github/workflows/desktop-release.yml
/.github/workflows/web-verify.yml

# Runtime history is not part of the editable public showcase.
/docs/showcase/**/.astral-history/
/docs/showcase/**/.astral-recovery/

# Source inventory, distinct from generated release archives.
!platforms/release/
!platforms/release/readiness.json

/docs/showcase/projects/renders/
/docs/showcase/projects/.astral-library*
